<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Filter</key>
	<dict>
		<!--
		  Substrate's default is to AND every filter type that is present.
		  Mode Any matches when any type matches. ElleKit's injector already
		  ORs Bundles and Executables and ignores Mode; Any keeps that
		  behavior if a Substrate-compatible loader is used.
		  SpringBoard and Preferences are load witnesses only. %ctor writes
		  runtime.status there and does not install Camera hooks.
		  Preferences is Settings.app. ElleKit on Dopamine injects that
		  UIKit app. mediaserverd is not listed.
		-->
		<key>Mode</key>
		<string>Any</string>
		<key>Bundles</key>
		<array>
			<string>com.apple.camera</string>
			<string>com.apple.springboard</string>
			<string>com.apple.Preferences</string>
		</array>
		<key>Executables</key>
		<array>
			<string>Camera</string>
			<string>SpringBoard</string>
			<string>Preferences</string>
		</array>
	</dict>
</dict>
</plist>
