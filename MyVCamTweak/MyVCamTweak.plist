<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Filter</key>
	<dict>
		<key>Bundles</key>
		<array>
			<!--
			  C1-A/B/C run inside Camera only. One bundle.
			  Exact bundle id. Does not match mediaserverd or SpringBoard.
			  C1-C arms the manager feed after startRunning returns,
			  unless a disable marker can be opened or test.mp4 cannot
			  be opened in the container, the jbroot mirror, or Documents.
			  The viewfinder overlay reads VideoInjector while that feed
			  is running.
			-->
			<string>com.apple.camera</string>
		</array>
	</dict>
</dict>
</plist>
